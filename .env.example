PORT=4000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/messenger
# اگر خطای querySrv ECONNREFUSED گرفتی، این را هم اضافه کن (DNS عمومی گوگل/کلادفلر):
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=یک-رشته-تصادفی-و-طولانی-اینجا-بگذار
# کلید رمزنگاری محتوای پیام‌ها (۳۲ بایت / ۶۴ کاراکتر هگز). بساز با:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGE_ENCRYPTION_KEY=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
